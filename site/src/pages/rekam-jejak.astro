---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import {
  assignments,
  categoryLabels,
  countByCategory,
  monthNumber,
  sortOptions,
  summary,
  tagOptions,
} from '../data/assignments';
import { site } from '../data/site';

/**
 * Rekam Jejak Manday — the assignment explorer and manday estimator.
 *
 * All 286 assignments are rendered into the page; the explorer script filters,
 * sorts and paginates the existing nodes rather than fetching data at runtime.
 * Each card mirrors its searchable fields onto data attributes so the script
 * never needs a second copy of the dataset.
 */

const categories = ['all', 'training', 'consultancy', 'auditor'];

const idNumber = (value: number): string => value.toLocaleString('id-ID');

const heroStats = [
  { value: String(summary.totalAssignments), label: 'Penugasan' },
  { value: idNumber(summary.totalMandays), label: 'Mandays' },
  { value: idNumber(summary.totalHours), label: 'Jam kerja' },
  { value: `${summary.totalClients}+`, label: 'Klien' },
];

/** Everything the keyword box searches, flattened once at build time. */
const haystack = (item: (typeof assignments)[number]): string =>
  [item.title, item.client, item.institution, item.location, item.tags.join(' ')].join(' ');
---

<Layout
  title="Rekam Jejak Manday — Adam Rahmat Agung"
  description="Eksplorasi 286 penugasan QHSE terverifikasi: 369,8 mandays, 2.958 jam kerja, 101 klien. Filter per kategori dan standar, plus kalkulator estimasi manday."
>
  <PageHero
    overline="Track record riil & portofolio mandays"
    title="Eksplorasi rekam jejak penugasan QHSE"
    lead="Seluruh data diverifikasi langsung dari riwayat kerja manday di berbagai sektor industri di seluruh Indonesia."
  >
    <div class="hero-stats">
      {
        heroStats.map((stat) => (
          <div class="hero-stat">
            <div class="hero-stat-value">{stat.value}</div>
            <div class="hero-stat-label" data-t>
              {stat.label}
            </div>
          </div>
        ))
      }
    </div>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="tabs" role="tablist" aria-label="Filter kategori penugasan" data-reveal>
        {
          categories.map((category, index) => (
            <button
              type="button"
              role="tab"
              class="tab"
              data-cat-tab={category}
              aria-selected={index === 0 ? 'true' : 'false'}
            >
              <span data-t>{categoryLabels[category]}</span>
              <span class="tab-count">{countByCategory(category)}</span>
            </button>
          ))
        }
      </div>

      <div class="controls" data-reveal>
        <input
          type="search"
          class="control control-search"
          placeholder="Cari klien (Chevron, PLN, Antam...), topik, atau kota"
          aria-label="Cari penugasan"
          data-t-placeholder
          data-t-aria
          data-assignment-search
        />

        <select class="control" aria-label="Filter standar atau topik" data-t-aria data-assignment-tag>
          {tagOptions.map((option) => <option value={option.value}>{option.label}</option>)}
        </select>

        <select class="control" aria-label="Urutkan penugasan" data-t-aria data-assignment-sort>
          {sortOptions.map((option) => <option value={option.value}>{option.label}</option>)}
        </select>
      </div>

      <div class="result-bar" data-reveal>
        <div>
          <span data-t>Menemukan</span>{' '}
          <strong data-result-count>{assignments.length}</strong>{' '}
          <span data-t>penugasan yang sesuai</span>
        </div>
        <div class="result-totals">
          <span>Mandays: <strong data-result-mandays>0</strong></span>
          <span>Jam: <strong data-result-hours>0</strong></span>
        </div>
      </div>

      <div class="assignments" data-assignment-list>
        {
          assignments.map((item) => (
            <article
              class="card card-hover assignment"
              data-assignment
              data-category={item.category}
              data-tags={item.tags.join('|')}
              data-search={haystack(item)}
              data-mandays={item.mandays}
              data-hours={item.hours}
              data-client={item.client}
              data-when={monthNumber(item.date)}
            >
              <div class="assignment-head">
                <span class:list={['cat-badge', `cat-${item.category}`]}>{item.categoryName}</span>
                <span class="assignment-id">{item.id}</span>
              </div>
              <h2 class="assignment-title">{item.title}</h2>
              <div class="assignment-client">{item.client}</div>
              <div class="assignment-meta">
                <span>{item.date}</span>
                <span>{item.mandays} manday · {item.hours} jam</span>
              </div>
              <div class="assignment-inst">
                <span data-t>Lembaga:</span> {item.institution} · {item.method}
              </div>
            </article>
          ))
        }
      </div>

      <p class="empty-state" data-assignment-empty hidden data-t>
        Tidak ada penugasan yang cocok dengan filter ini.
      </p>

      <div class="pager" data-pager>
        <button type="button" class="pager-btn" data-page-prev data-t>← Sebelumnya</button>
        <span class="page-label">
          <span data-t>Hal.</span> <span data-page-label>1 / 1</span>
        </span>
        <button type="button" class="pager-btn" data-page-next data-t>Berikutnya →</button>
      </div>
    </div>
  </section>

  <section id="kalkulator" class="section calculator-section">
    <div class="container">
      <div class="section-head" data-reveal>
        <div class="overline" data-t>Simulasi & estimasi kebutuhan</div>
        <h2 class="h1" data-t>Kalkulator estimasi manday</h2>
        <p class="muted" data-t>
          Dapatkan estimasi awal kebutuhan durasi penugasan dan kirim permohonan penawaran secara
          instan.
        </p>
      </div>

      <div
        class="calculator"
        data-calculator
        data-wa={site.waNumber}
        data-email={site.email}
        data-reveal
      >
        <div class="calc-fields card card-pad">
          <label class="field">
            <span class="field-label" data-t>Jenis layanan</span>
            <select name="service" class="control">
              <option value="training">Pelatihan / in-house training QHSE</option>
              <option value="consultancy">Konsultasi & pendampingan sistem</option>
              <option value="audit">Audit kepatuhan & pre-assessment</option>
            </select>
          </label>

          <label class="field">
            <span class="field-label" data-t>Standar / topik</span>
            <select name="standard" class="control">
              <option value="iso-integrated">Terintegrasi ISO 9001 + 14001 + 45001</option>
              <option value="smk3">SMK3 PP No. 50 Tahun 2012 (64/166 kriteria)</option>
              <option value="k3-umum">Ahli K3 Umum sertifikasi Kemnaker RI</option>
              <option value="hiradc">HIRADC & manajemen risiko K3</option>
              <option value="iso-single">Single standard (ISO 9001 / 14001 / 45001)</option>
            </select>
          </label>

          <label class="field">
            <span class="field-label" data-t>Skala perusahaan / jumlah peserta</span>
            <select name="scope" class="control">
              <option value="small">Kecil / 1-20 peserta / 1 lokasi</option>
              <option value="medium" selected>Menengah / 20-50 peserta / multi-plant</option>
              <option value="large">Besar / korporasi / kompleksitas tinggi</option>
            </select>
          </label>

          <label class="field">
            <span class="field-label" data-t>Lokasi pelaksanaan</span>
            <select name="location" class="control">
              <option value="jabodetabek">Jabodetabek / Banten / Jawa Barat</option>
              <option value="jawa">Jawa Tengah / Jawa Timur / Bali</option>
              <option value="remote">Luar Jawa / onshore / offshore</option>
            </select>
          </label>
        </div>

        <div class="calc-result">
          <div class="result-card">
            <div class="result-label" data-t>Hasil estimasi awal</div>
            <div class="result-days">
              <span data-calc-days>3</span> <span class="result-unit" data-t>mandays</span>
            </div>
            <div class="result-hours"><span data-calc-hours>24</span> <span data-t>jam kerja</span></div>
            <p class="result-rec" data-calc-recommendation></p>
          </div>

          <div class="result-actions">
            <a class="btn btn-green" href="#" target="_blank" rel="noopener" data-calc-wa data-t>
              Kirim permohonan via WhatsApp
            </a>
            <a class="btn btn-white-bordered" href="#" data-calc-email data-t>Kirim via email</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-12);
  }

  .hero-stat-value {
    font-family: var(--font-display);
    font-weight: var(--weight-black);
    font-size: clamp(28px, 3vw, 40px);
    line-height: 1;
    color: #fff;
  }

  .hero-stat-label {
    font-size: var(--text-small);
    color: var(--blue-200);
    margin-top: var(--space-2);
  }

  /* -------------------------------------------------------------- filters */

  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
    margin-bottom: var(--space-6);
  }

  .tab {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font: inherit;
    font-size: var(--text-small);
    font-weight: var(--weight-semibold);
    background: #fff;
    color: var(--text-body);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-pill);
    padding: 9px 18px;
    cursor: pointer;
    transition: var(--transition-control);
  }

  .tab:hover {
    border-color: var(--border-brand);
    color: var(--blue-700);
  }

  .tab[aria-selected='true'] {
    background: var(--blue-600);
    border-color: var(--blue-600);
    color: #fff;
  }

  .tab-count {
    font-size: 11px;
    font-weight: var(--weight-bold);
    background: rgba(4, 34, 63, 0.08);
    border-radius: var(--radius-pill);
    padding: 1px 7px;
  }

  .tab[aria-selected='true'] .tab-count {
    background: rgba(255, 255, 255, 0.22);
  }

  .controls {
    display: grid;
    grid-template-columns: minmax(240px, 2fr) minmax(180px, 1fr) minmax(160px, 1fr);
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  @media (max-width: 780px) {
    .controls {
      grid-template-columns: 1fr;
    }
  }

  .control {
    font: inherit;
    font-size: var(--text-small);
    color: var(--text-body);
    background: #fff;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-control);
    padding: 11px 14px;
    width: 100%;
    box-sizing: border-box;
    transition: var(--transition-control);
  }

  .control:focus {
    border-color: var(--border-brand);
  }

  .result-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-size: var(--text-small);
    color: var(--text-muted);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: var(--space-6);
  }

  .result-bar strong {
    color: var(--text-heading);
  }

  .result-totals {
    display: flex;
    gap: var(--space-5);
  }

  /* ---------------------------------------------------------- assignments */

  .assignments {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-5);
  }

  .assignment {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .assignment[hidden] {
    display: none;
  }

  .assignment-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .cat-badge {
    font-size: 10px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-radius: var(--radius-pill);
    padding: 3px 10px;
  }

  .cat-training {
    color: var(--blue-600);
    background: rgba(0, 103, 177, 0.1);
  }

  .cat-consultancy {
    color: var(--green-700);
    background: rgba(76, 154, 60, 0.12);
  }

  .cat-auditor {
    color: #b25e00;
    background: rgba(245, 166, 35, 0.15);
  }

  .assignment-id {
    font-size: 11px;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .assignment-title {
    font-family: var(--font-text);
    font-weight: var(--weight-bold);
    font-size: var(--text-small);
    line-height: 1.45;
    color: var(--text-heading);
    margin: 0;
    letter-spacing: 0;
  }

  .assignment-client {
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
    color: var(--blue-600);
  }

  .assignment-meta {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    font-size: 11px;
    color: var(--text-muted);
    padding-top: var(--space-2);
    margin-top: auto;
  }

  .assignment-inst {
    font-size: 11px;
    line-height: 1.45;
    color: var(--text-muted);
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--space-2);
  }

  .empty-state {
    text-align: center;
    color: var(--text-muted);
    margin-top: var(--space-10);
  }

  .pager {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-5);
    margin-top: var(--space-12);
  }

  .pager-btn {
    font: inherit;
    font-size: var(--text-small);
    font-weight: var(--weight-bold);
    color: var(--blue-600);
    background: #fff;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-control);
    padding: 10px 18px;
    cursor: pointer;
    transition: var(--transition-control);
  }

  .pager-btn:hover:not(:disabled) {
    background: var(--surface-brand-soft);
  }

  .pager-btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .page-label {
    font-size: var(--text-small);
    color: var(--text-muted);
  }

  /* ---------------------------------------------------------- calculator */

  .calculator-section {
    background: var(--surface-subtle);
  }

  .calculator {
    display: grid;
    grid-template-columns: minmax(280px, 1fr) minmax(280px, 1fr);
    gap: var(--space-8);
    align-items: start;
  }

  @media (max-width: 860px) {
    .calculator {
      grid-template-columns: 1fr;
    }
  }

  .calc-fields {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .field-label {
    font-size: var(--text-caption);
    font-weight: var(--weight-bold);
    color: var(--text-heading);
  }

  .calc-result {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .result-card {
    background: var(--blue-900);
    color: #fff;
    border-radius: var(--radius-card);
    padding: var(--space-8);
  }

  .result-label {
    font-size: var(--text-overline);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-overline);
    text-transform: uppercase;
    color: var(--green-500);
    margin-bottom: var(--space-4);
  }

  .result-days {
    font-family: var(--font-display);
    font-weight: var(--weight-black);
    font-size: clamp(44px, 5vw, 64px);
    line-height: 1;
    color: #fff;
  }

  .result-unit {
    font-size: 0.35em;
    color: var(--blue-200);
    letter-spacing: 0.04em;
  }

  .result-hours {
    font-size: var(--text-small);
    color: var(--blue-200);
    margin-top: var(--space-2);
  }

  .result-rec {
    font-size: var(--text-small);
    line-height: var(--leading-normal);
    color: var(--blue-200);
    margin: var(--space-5) 0 0;
    padding-top: var(--space-5);
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }

  .result-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .btn-white-bordered {
    background: #fff;
    color: var(--blue-700);
    border: 1px solid var(--border-default);
  }

  .btn-white-bordered:hover {
    background: var(--surface-brand-soft);
    color: var(--blue-800);
  }
</style>

<script>
  import { initRekamJejak, initCalculator } from '../scripts/rekam-jejak';

  initRekamJejak();
  initCalculator();
</script>

---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../components/Icon.astro';

/**
 * Konsultasi QHSE — the six-stage engagement.
 *
 * Signature scroll motion: numbered stages zoom in out of a blur.
 */

const stages: {
  num: string;
  icon: IconName;
  color: string;
  title: string;
  body: string;
  /** Stage 03 links across to the training page. */
  link?: { label: string; href: string; before: string; after: string };
}[] = [
  {
    num: '01',
    icon: 'users',
    color: 'var(--blue-600)',
    title: 'Kickoff meeting',
    body: 'Dimulai dengan penyampaian short brief pengembangan sistem manajemen dan lingkup sertifikasi (jika relevan), sehingga manajemen dan tim memahami arah, peran, serta target pendampingan sejak hari pertama.',
  },
  {
    num: '02',
    icon: 'search',
    color: 'var(--green-600)',
    title: 'Gap assessment',
    body: 'Kondisi eksisting dipetakan melalui teknik interview, dokumen review, dan site observation di area operasional seperti kantor, gudang, dan site proyek, menghasilkan potret gap kepatuhan yang jujur dan terukur.',
  },
  {
    num: '03',
    icon: 'graduation',
    color: 'var(--blue-600)',
    title: 'Awareness training',
    body: '',
    link: {
      before:
        'Peningkatan pemahaman tim melalui training yang dibawakan sesuai core process perusahaan, dengan metode pelaksanaan pelatihan yang sama partisipatifnya seperti pada ',
      label: 'sesi training',
      href: '/training/',
      after: '.',
    },
  },
  {
    num: '04',
    icon: 'file-text',
    color: 'var(--green-600)',
    title: 'Pengembangan sistem',
    body: 'Membantu perusahaan mengembangkan informasi terdokumentasi: business process, manual, procedure, instruksi kerja, dan formulir standar. Tidak hanya sebagai dokumen sertifikasi, namun aplikatif pada perusahaan Anda.',
  },
  {
    num: '05',
    icon: 'check-square',
    color: 'var(--blue-600)',
    title: 'Internal audit',
    body: 'Internal audit dilaksanakan secara relevan dan disesuaikan dengan scope sertifikasi, memastikan sistem benar-benar berjalan dan kesiapan organisasi teruji sebelum audit eksternal.',
  },
  {
    num: '06',
    icon: 'award',
    color: 'var(--sun-600)',
    title: 'Pendampingan audit sampai selesai',
    body: 'Keterlibatan konsultan dalam pendampingan audit adalah keharusan, sampai diperolehnya bukti berupa hasil sertifikasi yang diterbitkan oleh lembaga sertifikasi independen.',
  },
];
---

<Layout
  title="Konsultasi QHSE — Adam Rahmat Agung"
  description="Pendampingan sistem manajemen QHSE dari kickoff meeting sampai sertifikat terbit: gap assessment, awareness training, pengembangan dokumen, internal audit, dan pendampingan audit sertifikasi."
>
  <PageHero
    overline="Jasa → Konsultasi QHSE"
    title="Pendampingan sistem manajemen dari kickoff sampai sertifikat di tangan"
    lead="61+ penugasan konsultasi: integrasi ISO 9001/14001/45001, SMK3 PP 50/2012, hingga proyek berstandar migas. Sistem yang dibangun aplikatif untuk operasional, bukan sekadar dokumen sertifikasi."
  />

  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <div class="overline" data-t>Kenapa berbeda</div>
        <h2 class="h1" data-t>
          Enam tahapan pendampingan yang senantiasa dijalankan pada setiap penugasan konsultasi
        </h2>
      </div>

      <div class="grid stages" data-reveal>
        {
          stages.map((stage, index) => (
            <article
              class="card card-hover card-pad stage"
              data-anim="zoom-blur"
              style={`animation-delay:${(index * 0.09).toFixed(2)}s`}
            >
              <div class="stage-head">
                <span class="stage-num">{stage.num}</span>
                <span class="stage-icon">
                  <Icon name={stage.icon} size={20} stroke={stage.color} />
                </span>
              </div>
              <h3 class="h4 stage-title" data-t>
                {stage.title}
              </h3>
              {stage.link ? (
                <p class="stage-body">
                  <span data-t>{stage.link.before}</span>
                  <a href={stage.link.href} data-t>
                    {stage.link.label}
                  </a>
                  {stage.link.after}
                </p>
              ) : (
                <p class="stage-body" data-t>
                  {stage.body}
                </p>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section proof">
    <div class="container-narrow" data-reveal>
      <div class="overline" data-t>Bukti nyata</div>
      <h2 class="h1" data-t>61+ penugasan konsultasi sudah dijalankan</h2>
      <p data-t>
        Dari pendampingan sertifikasi ISO terintegrasi dan SMK3 hingga proyek Chevron, PLN, GBK, dan
        Rolls-Royce Solutions. Lihat riwayat lengkapnya beserta lembaga mitra dan lokasinya.
      </p>
      <div class="proof-actions">
        <a class="btn btn-primary" href="/rekam-jejak/?cat=consultancy" data-t>
          Lihat riwayat konsultasi →
        </a>
        <a class="btn btn-outline-dark" href="/klien/" data-t>Klien & rekanan</a>
      </div>
    </div>
  </section>

  <CtaBand
    title="Rencanakan pendampingan untuk perusahaan Anda"
    message="Halo Pak Adam, saya ingin berdiskusi tentang konsultasi QHSE"
    secondaryLabel="Kalkulator estimasi manday"
    secondaryHref="/rekam-jejak/#kalkulator"
  />
</Layout>

<style>
  .stages {
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }

  .stage {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .stage-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .stage-num {
    font-family: var(--font-display);
    font-weight: var(--weight-black);
    font-size: 30px;
    line-height: 1;
    color: var(--blue-200);
  }

  .stage-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--surface-brand-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }

  .stage-title {
    color: var(--text-heading);
  }

  .stage-body {
    margin: 0;
    font-size: var(--text-small);
    line-height: var(--leading-normal);
    color: var(--text-muted);
  }

  .proof {
    background: var(--surface-subtle);
    text-align: center;
  }

  .proof .overline {
    margin-bottom: var(--space-3);
  }

  .proof p {
    margin: var(--space-4) auto var(--space-8);
    max-width: 60ch;
    color: var(--text-body);
  }

  .proof-actions {
    display: flex;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .btn-outline-dark {
    border: 2px solid var(--border-default);
    background: transparent;
    color: var(--blue-700);
    padding: 12px 26px;
  }

  .btn-outline-dark:hover {
    background: var(--surface-brand-soft);
    color: var(--blue-800);
  }
</style>

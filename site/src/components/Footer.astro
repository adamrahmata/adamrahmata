---
import BrandIcon from './BrandIcon.astro';
import type { BrandName } from './BrandIcon.astro';
import { site, waHref } from '../data/site';

/**
 * Site footer, shared by every page. Contact channels are brand icon buttons;
 * each carries an aria-label and a title so the destination is still announced
 * to screen readers and shown on hover.
 */

const channels: { icon: BrandName; label: string; href: string; external?: boolean }[] = [
  { icon: 'whatsapp', label: `WhatsApp ${site.waNumberDisplay}`, href: waHref(), external: true },
  { icon: 'email', label: site.email, href: `mailto:${site.email}` },
  { icon: 'linkedin', label: 'LinkedIn', href: site.linkedin, external: true },
  { icon: 'instagram', label: 'Instagram', href: site.instagram, external: true },
];
---

<footer class="site-footer">
  <div class="footer-brand">adamrahmata<span>.com</span></div>
  <div class="footer-role" data-t>QHSE Trainer, Consultant and Auditor</div>

  <ul class="footer-social">
    {
      channels.map((channel) => (
        <li>
          <a
            href={channel.href}
            class={`social social-${channel.icon}`}
            aria-label={channel.label}
            title={channel.label}
            target={channel.external ? '_blank' : undefined}
            rel={channel.external ? 'noopener' : undefined}
          >
            <BrandIcon name={channel.icon} size={20} />
          </a>
        </li>
      ))
    }
  </ul>

  <div class="footer-legal">
    &copy; {new Date().getFullYear()} {site.name}, <span data-t>Praktisi, Trainer, Konsultan &amp; Auditor QHSE</span>
  </div>
</footer>

<style>
  .footer-brand {
    font-family: var(--font-display);
    font-weight: var(--weight-black);
    font-size: 16px;
    color: #fff;
    margin-bottom: var(--space-2);
  }

  .footer-brand span {
    color: var(--green-500);
  }

  .footer-role {
    margin-bottom: var(--space-5);
  }

  .footer-social {
    list-style: none;
    margin: 0 0 var(--space-5);
    padding: 0;
    display: flex;
    justify-content: center;
    gap: var(--space-3);
  }

  .social {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
    transition:
      transform var(--dur-fast) var(--ease-standard),
      var(--transition-control);
  }

  /* On the dark footer the marks sit muted white and take on their brand
     colour on hover, so the row reads as one set at rest. */
  .social:hover {
    transform: translateY(-2px);
    color: #fff;
    text-decoration: none;
  }

  .social-whatsapp:hover {
    background: #25d366;
    border-color: #25d366;
  }

  .social-instagram:hover {
    background: #e4405f;
    border-color: #e4405f;
  }

  .social-linkedin:hover {
    background: #0a66c2;
    border-color: #0a66c2;
  }

  .social-email:hover {
    background: var(--blue-500);
    border-color: var(--blue-500);
  }

  .social:focus-visible {
    outline: 2px solid var(--green-500);
    outline-offset: 2px;
  }

  .footer-legal {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.55);
  }
</style>

---
import Icon from '../Icon.astro';
import type { IconName } from '../Icon.astro';

/**
 * Section 12 — "Ada apa saja di sini?". Mirrors the top bar exactly, one card
 * per destination, each with its own idling icon animation.
 */

interface Tile {
  href: string;
  icon: IconName;
  /** Idle animation on the icon: bob, pulse or tilt. */
  motion: string;
  title: string;
  desc: string;
  cta: string;
  dark?: boolean;
}

const tiles: Tile[] = [
  {
    href: '/jasa/',
    icon: 'briefcase',
    motion: 'ara-bob 3s ease-in-out infinite',
    title: 'Jasa & Layanan',
    desc: 'Training, konsultasi, audit, standar & metodologi kerja QHSE.',
    cta: 'Buka →',
  },
  {
    href: '/rekam-jejak/',
    icon: 'chart',
    motion: 'ara-bob 2.4s ease-in-out infinite',
    title: 'Rekam Jejak Manday',
    desc: '279+ penugasan terverifikasi, filter kategori & standar, plus kalkulator manday.',
    cta: 'Jelajahi →',
    dark: true,
  },
  {
    href: '/klien/',
    icon: 'users',
    motion: 'ara-pulse 2.8s ease-in-out infinite',
    title: 'Klien & Rekanan',
    desc: 'Dinding logo 75+ klien korporasi dan 24 lembaga mitra per sektor.',
    cta: 'Buka →',
  },
  {
    href: '/artikel/',
    icon: 'pen',
    motion: 'ara-tilt 3.2s ease-in-out infinite',
    title: 'Artikel',
    desc: 'Tulisan seputar K3, sistem manajemen, dan budaya keselamatan.',
    cta: 'Buka →',
  },
  {
    href: '/kontak/',
    icon: 'chat',
    motion: 'ara-pulse 2.2s ease-in-out infinite',
    title: 'Kontak & Kolaborasi',
    desc: 'Diskusikan kebutuhan training, konsultasi, atau audit Anda.',
    cta: 'Buka →',
  },
];
---

<section id="jelajah" class="section explore">
  <div class="container">
    <div class="section-head" data-reveal>
      <div class="overline" data-t>Jelajahi website ini</div>
      <h2 class="h1" data-t>Ada apa saja di sini?</h2>
    </div>

    <div class="grid grid-cards-lg" data-reveal>
      {
        tiles.map((tile, index) => (
          <a
            href={tile.href}
            class:list={['card', 'card-hover', 'tile', { 'is-dark': tile.dark }]}
            data-stagger
            style={`--stagger-delay:${(index * 0.08).toFixed(2)}s`}
          >
            <span class="tile-icon">
              <span class="tile-glyph" style={`animation:${tile.motion}`}>
                <Icon
                  name={tile.icon}
                  size={22}
                  stroke={tile.dark ? 'var(--green-500)' : 'var(--blue-600)'}
                />
              </span>
            </span>
            <span class="tile-title" data-t>
              {tile.title}
            </span>
            <span class="tile-desc" data-t>
              {tile.desc}
            </span>
            <span class="tile-cta" data-t>
              {tile.cta}
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .explore {
    background: var(--surface-subtle);
  }

  .tile {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    text-decoration: none;
  }

  .tile:hover {
    text-decoration: none;
  }

  .tile-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--surface-brand-soft);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tile-glyph {
    display: inline-flex;
  }

  .tile-title {
    font-family: var(--font-display);
    font-weight: var(--weight-black);
    font-size: var(--text-h4);
    color: var(--text-heading);
  }

  .tile-desc {
    font-size: var(--text-small);
    line-height: var(--leading-normal);
    color: var(--text-muted);
  }

  .tile-cta {
    font-size: 12px;
    font-weight: var(--weight-bold);
    color: var(--blue-500);
    margin-top: auto;
  }

  /* Rekam Jejak is the flagship module, so it gets the dark treatment. */
  .tile.is-dark {
    background: var(--blue-900);
    border-color: var(--blue-800);
  }

  .is-dark .tile-icon {
    background: rgba(255, 255, 255, 0.14);
  }

  .is-dark .tile-title {
    color: #fff;
  }

  .is-dark .tile-desc {
    color: var(--blue-200);
  }

  .is-dark .tile-cta {
    color: var(--green-500);
  }
</style>

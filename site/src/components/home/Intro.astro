---
/**
 * Section 03 — "Perkenalkan saya".
 *
 * White panel laid out as a single centred column: the copy sits at the top,
 * the standing photo below it and bottom-aligned so it meets the panel edge.
 * The entrance still differs from section 02 — copy rises in steps, the green
 * rule grows outward from the centre, the photo follows last. The three names
 * swell like balloons on a 1.5s stagger.
 */

const names = [
  { prefix: 'Lebih senang dipanggil', name: 'Adam', color: 'var(--sun-600)', delay: '0s', tail: ',' },
  { prefix: 'Lebih mulia dipanggil', name: 'Rahmat', color: 'var(--blue-500)', delay: '1.5s', tail: ',' },
  { prefix: 'Lebih dekat dipanggil', name: 'Agung', color: 'var(--green-600)', delay: '3s', tail: '.' },
];
---

<section class="panel intro">
  <div class="copy">
    <div data-reveal>
      <div class="overline eyebrow" data-t>Perkenalkan saya</div>
      <h2 class="display-2 name" data-t>Adam Rahmat Agung</h2>
    </div>

    <div class="rule" data-reveal="grow-x" style="--reveal-delay:.3s"></div>

    <div class="lines" data-reveal style="--reveal-delay:.45s">
      {
        names.map((n) => (
          <p class="lead">
            <span data-t>{n.prefix}</span>{' '}
            <strong class="balloon" style={`color:${n.color};animation-delay:${n.delay}`}>
              {n.name}
            </strong>
            {n.tail}
          </p>
        ))
      }
    </div>
  </div>

  <div class="photo" data-reveal style="--reveal-delay:.6s">
    <img src="/img/adam-standing.png" alt="Adam Rahmat Agung" width="560" height="900" loading="lazy" />
  </div>
</section>

<style>
  .intro {
    background: #fff;
    color: var(--neutral-700);
    flex-direction: column;
    align-items: center;
    text-align: center;
    /* No bottom padding: the photo is meant to meet the panel edge. */
    padding: var(--space-24) var(--gutter) 0;
  }

  .copy {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    flex: none;
  }

  /* Takes whatever vertical room the copy leaves, so the figure scales with
     the panel instead of overflowing it. */
  .photo {
    flex: 1 1 auto;
    min-height: 0;
    margin-top: var(--space-8);
    pointer-events: none;
  }

  .photo img {
    height: 100%;
    width: auto;
    max-width: 100%;
    display: block;
    object-fit: contain;
    object-position: bottom;
    filter: drop-shadow(0 12px 32px rgba(4, 34, 63, 0.18));
  }

  /* "Perkenalkan saya" is set black-weight, per the chat 2 revision. */
  .eyebrow {
    font-weight: var(--weight-black);
    margin-bottom: var(--space-4);
  }

  .name {
    color: var(--text-heading);
  }

  /* Grows outward from the middle now that the column is centred. */
  .rule {
    width: 96px;
    height: 5px;
    background: var(--green-600);
    border-radius: var(--radius-pill);
    transform-origin: 50% 50%;
  }

  .lines {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .lines p {
    margin: 0;
    color: var(--neutral-700);
  }

  .balloon {
    display: inline-block;
    transform-origin: 50% 100%;
    animation: ara-balloon 4.5s ease-in-out infinite;
  }

  @media (max-width: 900px) {
    .intro {
      padding-top: var(--space-16);
    }

    .photo {
      flex: 0 0 auto;
      height: 60vw;
      max-height: 420px;
    }
  }
</style>

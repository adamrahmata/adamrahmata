---
/**
 * Section 02 — "Apakah teman-teman sedang mencari ...."
 *
 * Laid out as a single centred column: the questions on top, the thinking photo
 * below them and bottom-aligned so it meets the panel edge. A busy cluster of
 * floating question marks surrounds the head (chat 2: "tempatkan sangat dekat
 * dan buatkan ramai"). The photo itself stays still; only the marks move. The
 * three questions still wipe in, then the amber closing line scales up.
 */

/** Floating marks clustered over the head and shoulders, never the text column. */
const marks = [
  { char: '?', top: '14%', left: '20%', size: 48, color: 'var(--sun-500)', dur: '4.2s', delay: '0s' },
  { char: '?', top: '10%', left: '66%', size: 36, color: 'var(--green-500)', dur: '5s', delay: '1.1s' },
  { char: '?', top: '8%', left: '44%', size: 30, color: 'rgba(255,255,255,.9)', dur: '5.6s', delay: '2s' },
  { char: '?', top: '22%', left: '8%', size: 26, color: 'var(--blue-200)', dur: '4.8s', delay: '.6s' },
  { char: '?', top: '12%', left: '30%', size: 22, color: 'rgba(255,255,255,.7)', dur: '5.2s', delay: '1.6s' },
  { char: '?', top: '9%', left: '58%', size: 24, color: 'var(--sun-500)', dur: '4.6s', delay: '2.6s' },
  { char: '?', top: '20%', left: '74%', size: 26, color: 'var(--blue-200)', dur: '5.4s', delay: '.3s' },
  { char: '…', top: '30%', left: '70%', size: 28, color: 'rgba(255,255,255,.85)', dur: '4.4s', delay: '1.9s' },
];

const dots = [
  { top: '30%', left: '16%', size: 10, color: 'var(--green-500)', dur: '4s', delay: '1.3s' },
  { top: '14%', left: '38%', size: 7, color: 'var(--sun-500)', dur: '5.8s', delay: '.9s' },
  { top: '16%', left: '52%', size: 6, color: 'rgba(255,255,255,.8)', dur: '4.9s', delay: '2.3s' },
];

const questions = [
  { text: 'Instruktur, Trainer, atau Teman belajar?', color: '#fff', delay: '.1s' },
  { text: 'Konsultan?', color: 'var(--blue-200)', delay: '.25s' },
  { text: 'Auditor internal/eksternal, atau Gap assessor?', color: 'var(--blue-200)', delay: '.4s' },
];
---

<section class="panel seeking">
  <div class="copy">
    <div class="overline overline-invert lead-in" data-reveal data-t>
      Apakah teman-teman sedang mencari ....
    </div>

    {
      questions.map((q) => (
        <div class="line" data-reveal="right" style={`--reveal-delay:${q.delay}`}>
          <span class="question" style={`color:${q.color}`} data-wipe data-t>
            {q.text}
          </span>
        </div>
      ))
    }

    <div class="line closer" data-reveal="scale" style="--reveal-delay:.65s">
      <span data-t>Atau mitra karya?</span>
    </div>
  </div>

  <div class="photo" data-reveal style="--reveal-delay:.8s">
    <img
      src="/img/adam-thinking.png"
      alt="Adam Rahmat Agung sedang berpikir"
      width="620"
      height="900"
      fetchpriority="high"
    />
    {
      marks.map((m) => (
        <span
          class="mark"
          aria-hidden="true"
          style={`top:${m.top};left:${m.left};font-size:${m.size}px;color:${m.color};animation-duration:${m.dur};animation-delay:${m.delay}`}
        >
          {m.char}
        </span>
      ))
    }
    {
      dots.map((d) => (
        <span
          class="dot"
          aria-hidden="true"
          style={`top:${d.top};left:${d.left};width:${d.size}px;height:${d.size}px;background:${d.color};animation-duration:${d.dur};animation-delay:${d.delay}`}
        />
      ))
    }
  </div>
</section>

<style>
  .seeking {
    background: var(--blue-700);
    color: #fff;
    flex-direction: column;
    align-items: center;
    text-align: center;
    /* No bottom padding: the figure is meant to meet the panel edge (chat 2:
       "turunkan sehingga berbatasan dengan bagian biru"). */
    padding: var(--space-24) var(--gutter) 0;
  }

  /* Takes whatever vertical room the questions leave, so the figure scales
     with the panel instead of overflowing it. */
  .photo {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    margin-top: var(--space-6);
    pointer-events: none;
  }

  .photo img {
    height: 100%;
    width: auto;
    max-width: 100%;
    display: block;
    filter: drop-shadow(0 12px 32px rgba(4, 34, 63, 0.45));
  }

  .mark,
  .dot {
    position: absolute;
    animation-name: ara-q;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }

  .mark {
    font-family: var(--font-display);
    font-weight: var(--weight-black);
    line-height: 1;
  }

  .dot {
    border-radius: 50%;
  }

  .copy {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    position: relative;
    z-index: 1;
    flex: none;
  }

  .lead-in {
    margin-bottom: var(--space-2);
  }

  .question {
    font-family: var(--font-display);
    font-weight: var(--weight-black);
    font-size: var(--text-display-2);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-tight);
  }

  .closer {
    margin-top: var(--space-5);
    transform-origin: 50% 80%;
  }

  .closer span {
    font-family: var(--font-display);
    font-weight: var(--weight-black);
    font-size: var(--text-display-1);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-tight);
    color: var(--sun-500);
  }

  @media (max-width: 900px) {
    .seeking {
      padding-top: var(--space-16);
    }

    .photo {
      flex: 0 0 auto;
      height: 60vw;
      max-height: 420px;
    }
  }
</style>

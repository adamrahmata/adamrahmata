---
import fs from 'node:fs';
import Icon from '../Icon.astro';
import type { IconName } from '../Icon.astro';
import { stats } from '../../data/site';

/**
 * The portrait beside the statistics is optional. It is checked for at build
 * time rather than hard-coded, so the section lays out as a single centred
 * column until the file exists and switches to the two-column arrangement the
 * moment it is dropped in — no broken image in between, no code change needed.
 */
const PHOTO = '/img/adam-thumbsup.png';
const hasPhoto = fs.existsSync(new URL(`../../../public${PHOTO}`, import.meta.url));

/**
 * Section 04 — the 16-years statement with the five counting statistics
 * folded in beneath it (chat 2 merged the standalone "Dalam angka" panel
 * into this one).
 */

interface Tile {
  value: number;
  decimals?: number;
  icon: IconName;
  color: string;
  /** Staggered float so the icons never bob in unison. */
  bob: string;
  title: string;
  desc: string;
}

const tiles: Tile[] = [
  {
    value: stats.mandays,
    decimals: 1,
    icon: 'calendar',
    color: 'var(--sun-500)',
    bob: '0s',
    title: 'Mandays portofolio',
    desc: 'Total hari penugasan resmi seperti training, konsultasi dan audit.',
  },
  {
    value: stats.hours,
    icon: 'clock',
    color: 'var(--green-500)',
    bob: '.9s',
    title: 'Jam kerja QHSE',
    desc: 'Akumulasi jam mengajar di kelas dan mendampingi client melalui sesi konsultasi dan kegiatan audit.',
  },
  {
    value: stats.clients,
    icon: 'users',
    color: 'var(--sun-500)',
    bob: '1.8s',
    title: 'Klien korporasi',
    desc: 'Perusahaan dari beragam sektor seperti manufaktur, minyak dan gas, pertambangan, konstruksi pernah menugaskan melalui lembaga mitra.',
  },
  {
    value: stats.partners,
    icon: 'building',
    color: 'var(--green-500)',
    bob: '3.6s',
    title: 'Lembaga mitra',
    desc: 'Lembaga training dan konsultan seperti PJK3, TUK, Lembaga independen lainnya pernah menggandeng sebagai mitra.',
  },
  {
    value: stats.projects,
    icon: 'presentation',
    color: 'var(--green-500)',
    bob: '2.7s',
    title: 'Proyek & sesi training',
    desc: 'Sesi pelatihan, proyek konsultasi, dan penugasan audit yang tuntas.',
  },
];
---

<section class="panel stats">
  <div class:list={['container', 'inner', { 'has-photo': hasPhoto }]}>
    {/* The explicit {' '} separators are load-bearing: Astro collapses the
        whitespace between elements written on separate lines, which would run
        the sentence together as "lebih dari16tahun". */}
    <p class="statement" data-reveal>
      <span data-t>Alhamdulillah, telah berkontribusi lebih dari</span>{' '}
      <span class="years" data-count-to={stats.years} data-count-duration="1500">0</span>{' '}
      <span data-t>tahun</span><br />
      <span data-t>perjalanan karier di bidang Quality, Health, Safety, and Environment (QHSE).</span>
    </p>

    <div class="tiles" data-reveal style="--reveal-delay:.2s">
      {
        tiles.map((tile, index) => (
          <div class="tile" data-stagger style={`--stagger-delay:${(index * 0.14).toFixed(2)}s`}>
            <span class="tile-icon" style={`animation-delay:${tile.bob}`}>
              <Icon name={tile.icon} size={26} stroke={tile.color} />
            </span>
            <span class="tile-value">
              <span
                data-count-to={tile.value}
                data-count-decimals={tile.decimals ?? 0}
              >
                0
              </span>
              <span class="plus">+</span>
            </span>
            <span class="tile-title" data-t>
              {tile.title}
            </span>
            <span class="tile-desc" data-t>
              {tile.desc}
            </span>
          </div>
        ))
      }
    </div>

    {
      hasPhoto && (
        <div class="portrait" data-reveal="right" style="--reveal-delay:.95s">
          <div class="portrait-drift">
            <img
              class="sticker"
              src={PHOTO}
              alt="Adam Rahmat Agung mengacungkan dua jempol"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  /* Height follows the content instead of a locked 16:9 box. The fixed ratio
     left ~320px of dead blue below the figures on wide screens, and — worse —
     was too short from 1280px down, where .panel's overflow:hidden was quietly
     clipping the bottom row of statistics. A floor keeps it generous on wide
     screens without ever cutting anything off. */
  .stats {
    aspect-ratio: auto;
    min-height: min(42vw, 700px);
    background: var(--blue-700);
    color: #fff;
    align-items: center;
    padding: var(--space-24) var(--gutter) var(--space-20);
  }

  .inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  /* With the portrait present the statement still spans the full width, and
     the statistics and the photo share the row beneath it. */
  /* The right-hand column is left empty on purpose: the portrait is taken out
     of flow so it can sit on the section's bottom edge, and this reserves the
     space it occupies so the tiles never run underneath it. */
  .inner.has-photo {
    display: grid;
    /* Wide enough for the portrait at its rendered size: the photo is 768x1365,
       so at 88% of a 16:9 panel it occupies about 28vw. */
    grid-template-columns: minmax(0, 1fr) clamp(300px, 30vw, 580px);
    grid-template-areas:
      'statement statement'
      'tiles     reserved';
    gap: var(--space-12) var(--space-16);
    align-items: center;
  }

  .has-photo .statement {
    grid-area: statement;
  }

  /* Three across, not auto-fit: in the narrower column auto-fit still packed
     all five onto one row and the large figures ran into each other. */
  .has-photo .tiles {
    grid-area: tiles;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-10) var(--space-8);
  }

  @media (max-width: 1240px) {
    .has-photo .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Sits on the boundary between this blue panel and the white section below.
     The source photo is cropped mid-body, so anchoring its cut edge exactly to
     the section edge reads as standing at the seam rather than as a mistake. */
  /* Deliberately taller than the panel and hung below its edge, so the section
     boundary crops the figure mid-body. The photo is already cut off in the
     file; cropping it further at the seam is what sells the illusion of
     standing behind it. */
  /* Sized from the viewport width, never from the panel height: the panel grows
     as the statistics wrap onto more rows, and a height-based photo grew with
     it until it was wide enough to sit on top of the figures.
     Width stays just inside the reserved 30vw column at every size.

     `translate` hangs it 12% of its own height below the section edge so the
     boundary crops the body — the property is independent of `transform`, which
     the reveal resets to none. */
  .portrait {
    position: absolute;
    right: var(--gutter);
    bottom: 0;
    width: clamp(240px, 27vw, 520px);
    translate: 0 12%;
    z-index: 1;
    pointer-events: none;
  }

  .portrait-drift {
    /* Pivots on the bottom edge so the figure stays planted while it drifts. */
    transform-origin: 50% 100%;
    animation: ara-sway 7s ease-in-out infinite;
  }

  .portrait img {
    width: 100%;
    height: auto;
    display: block;
    --sticker-size: 10px;
  }

  /* Too little room to stand the figure beside the numbers, so it returns to
     the flow and sits below them, still meeting the section's bottom edge. */
  @media (max-width: 900px) {
    .inner.has-photo {
      grid-template-columns: 1fr;
      grid-template-areas:
        'statement'
        'tiles';
      /* Clears the room the out-of-flow portrait needs below the tiles. Must
         stay in step with .portrait's height below. */
      /* Clears the room the out-of-flow portrait needs below the tiles. Must
         stay in step with .portrait's width below (height = width / 0.5626). */
      padding-bottom: calc(min(58vw, 300px) / 0.5626);
    }

    .has-photo .tiles {
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    }

    .portrait {
      right: 50%;
      width: min(58vw, 300px);
      /* Centring and the 12% crop share the one `translate` declaration. */
      translate: 50% 12%;
    }
  }

  .statement {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--weight-black);
    font-size: var(--text-h2);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-display);
    color: #fff;
    text-wrap: balance;
  }

  /* Counts up like the statistics below, then swells once and settles. The
     delay lets the count finish first, so the swell reads as the punctuation
     on the number rather than competing with it. */
  .years {
    color: var(--sun-500);
    font-size: 1.6em;
    line-height: 1;
    display: inline-block;
    transform-origin: 50% 80%;
    font-variant-numeric: tabular-nums;
    animation: ara-swell 1.1s var(--ease-out) 1.6s 1 both;
    animation-play-state: paused;
  }

  .is-in .years {
    animation-play-state: running;
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-10);
  }

  .tile {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: center;
  }

  .tile-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    animation: ara-bob 3.6s ease-in-out infinite;
  }

  .tile-value {
    font-family: var(--font-display);
    font-weight: var(--weight-black);
    font-size: clamp(44px, 4.5vw, 68px);
    letter-spacing: -0.02em;
    line-height: 1;
    /* Tabular figures keep the row from jittering while the count runs. */
    font-variant-numeric: tabular-nums;
  }

  .plus {
    color: var(--green-500);
  }

  .tile-title {
    font-size: var(--text-body);
    font-weight: var(--weight-bold);
    color: #fff;
  }

  .tile-desc {
    font-size: var(--text-small);
    line-height: 1.5;
    color: var(--blue-200);
    max-width: 34ch;
  }
</style>

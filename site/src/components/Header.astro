---
import { nav, waHref } from '../data/site';

interface Props {
  /** Path of the current page, used to mark the active nav item. */
  current?: string;
}

const { current = Astro.url.pathname } = Astro.props;

const isActive = (href: string): boolean =>
  href === '/' ? current === '/' : current.startsWith(href);
---

<header class="site-header">
  <a class="brand" href="/">adamrahmata<span>.com</span></a>

  <nav class="site-nav" aria-label="Navigasi utama">
    {
      nav.map((item) => (
        <a
          href={item.href}
          class:list={['nav-link', { 'is-current': isActive(item.href) }]}
          aria-current={isActive(item.href) ? 'page' : undefined}
          data-t
        >
          {item.label}
        </a>
      ))
    }

    <span class="lang-switch" role="group" aria-label="Pilihan bahasa">
      <button type="button" data-lang-set="id" class="is-active" aria-current="true">ID</button>
      <span aria-hidden="true">|</span>
      <button type="button" data-lang-set="en">EN</button>
    </span>

    <a class="wa-button" href={waHref()} target="_blank" rel="noopener" data-t>Chat WA</a>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--blue-900);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 14px var(--space-8);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .brand {
    font-family: var(--font-display);
    font-weight: var(--weight-black);
    font-size: 18px;
    letter-spacing: -0.02em;
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
  }

  .brand:hover {
    color: #fff;
    text-decoration: none;
  }

  .brand span {
    color: var(--green-500);
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .nav-link {
    font-size: 14px;
    font-weight: var(--weight-semibold);
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 2px solid transparent;
    transition: var(--transition-control);
  }

  .nav-link:hover {
    color: #fff;
    text-decoration: none;
  }

  /* Active page: white text with the green underline, per chat 3. */
  .nav-link.is-current {
    color: #fff;
    font-weight: var(--weight-bold);
    border-bottom-color: var(--green-500);
  }

  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 13px;
    font-weight: var(--weight-bold);
  }

  .lang-switch > span {
    color: rgba(255, 255, 255, 0.35);
  }

  .lang-switch button {
    background: none;
    border: 0;
    padding: 0 0 2px;
    font: inherit;
    color: rgba(255, 255, 255, 0.55);
    border-bottom: 2px solid transparent;
    cursor: pointer;
    transition: var(--transition-control);
  }

  .lang-switch button:hover {
    color: #fff;
  }

  .lang-switch button.is-active {
    color: #fff;
    border-bottom-color: var(--green-500);
  }

  .wa-button {
    font-size: 14px;
    font-weight: var(--weight-bold);
    color: #fff;
    background: var(--green-600);
    padding: 8px 16px;
    border-radius: var(--radius-control);
    text-decoration: none;
    white-space: nowrap;
    transition: var(--transition-control);
  }

  .wa-button:hover {
    background: var(--green-700);
    color: #fff;
    text-decoration: none;
  }

  @media (max-width: 720px) {
    .site-header {
      flex-direction: column;
      align-items: stretch;
      padding: 12px var(--space-4);
      gap: var(--space-3);
    }

    .site-nav {
      justify-content: center;
      gap: var(--space-4);
      row-gap: var(--space-2);
    }
  }
</style>
